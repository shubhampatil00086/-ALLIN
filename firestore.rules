rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function admin(){return signedIn() && request.auth.token.admin == true;}
  function owner(uid){return signedIn() && request.auth.uid == uid;}
  match /users/{uid} {
   allow read: if owner(uid) || admin();
   allow create: if owner(uid) && request.resource.data.uid == uid
     && request.resource.data.role in ['umpire','organizer']
     && request.resource.data.accountStatus == 'active'
     && request.resource.data.email == request.auth.token.email;
   allow update: if admin() || (owner(uid)
     && request.resource.data.role == resource.data.role
     && request.resource.data.accountStatus == resource.data.accountStatus
     && request.resource.data.uid == resource.data.uid
     && request.resource.data.email == resource.data.email
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','phone','city','updatedAt']));
   allow delete: if admin();
  }
  match /umpireProfiles/{uid} {
   allow read: if owner(uid) || admin();
   allow create: if owner(uid) && request.resource.data.uid == uid
     && (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'incomplete');
   allow update: if owner(uid) && request.resource.data.uid == uid
     && request.resource.data.verificationStatus == resource.data.verificationStatus;
   allow delete: if admin();
  }
  match /organizerProfiles/{uid} {allow read: if owner(uid)||admin();allow create,update: if owner(uid)&&request.resource.data.uid==uid;allow delete: if admin();}
  match /events/{id} {allow read: if resource.data.status=='published'||admin()||(signedIn()&&resource.data.organizerId==request.auth.uid);allow create: if signedIn()&&request.resource.data.organizerId==request.auth.uid&&request.resource.data.status=='draft';allow update: if admin()||(signedIn()&&resource.data.organizerId==request.auth.uid&&request.resource.data.organizerId==resource.data.organizerId&&request.resource.data.status==resource.data.status);allow delete: if admin();}
  match /bookings/{id} {allow read: if admin()||(signedIn()&&(resource.data.umpireId==request.auth.uid||resource.data.organizerId==request.auth.uid));allow write: if false;}
  match /verificationRequests/{id} {allow read: if admin()||(signedIn()&&resource.data.uid==request.auth.uid);allow write: if admin();}
  match /applications/{id} {allow read: if admin()||(signedIn()&&resource.data.umpireId==request.auth.uid);allow write: if false;}
  match /completedAssignments/{id} {allow read: if admin()||(signedIn()&&(resource.data.umpireId==request.auth.uid||resource.data.organizerId==request.auth.uid));allow write: if false;}
  match /reviews/{id} {allow read: if resource.data.status=='published'||admin()||(signedIn()&&resource.data.organizerId==request.auth.uid);allow write: if false;}
  match /payments/{id} {allow read: if admin()||(signedIn()&&resource.data.organizerId==request.auth.uid);allow write: if false;}
  match /refunds/{id} {allow read: if admin();allow write: if false;}
  match /payouts/{id} {allow read: if admin()||(signedIn()&&resource.data.umpireId==request.auth.uid);allow write: if false;}
  match /commissionLedger/{id} {allow read: if admin();allow write: if false;}
  match /notifications/{id} {allow read: if admin()||(signedIn()&&resource.data.uid==request.auth.uid);allow write: if false;}
  match /notificationLogs/{id} {allow read: if admin();allow write: if false;}
  match /auditLogs/{id} {allow read: if admin();allow write: if false;}
  match /exportLogs/{id} {allow read: if admin();allow write: if false;}
  match /disputes/{id} {allow read: if admin()||(signedIn()&&(resource.data.organizerId==request.auth.uid||resource.data.umpireId==request.auth.uid));allow write: if false;}
  match /{document=**} {allow read,write: if false;}
 }
}